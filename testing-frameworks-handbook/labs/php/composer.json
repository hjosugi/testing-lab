{
  "name": "handbook/checkout-lab",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "infection/infection": "0.34.0",
    "phpunit/phpunit": "13.2.4"
  },
  "autoload": {
    "classmap": ["src/"]
  },
  "autoload-dev": {
    "psr-4": { "Handbook\\Checkout\\Tests\\": "tests/" },
    "classmap": ["mutation-fixtures/"]
  },
  "scripts": {
    "test": "phpunit --display-all-issues --fail-on-all-issues",
    "migration": "./scripts/verify-phpunit-migration.sh",
    "mutation": "./scripts/run-mutation.sh",
    "mutation:equivalent": "./scripts/verify-equivalent-mutant.sh"
  },
  "config": {
    "allow-plugins": { "infection/extension-installer": true },
    "sort-packages": true
  }
}
