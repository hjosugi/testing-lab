{
  "name": "testing-handbook-system-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:component && npm run test:http-integration && npm run test:contract && npm run test:property",
    "test:component": "node --test test/component/*.test.js",
    "test:http-adapter": "npm run test:http-integration",
    "test:http-integration": "node --test test/http/*.test.js",
    "test:http-stability": "node scripts/verify-http-stability.mjs",
    "test:contract": "node --test test/contract.test.js",
    "test:property": "node --test test/property.test.js",
    "test:api-schema": "node api-tests/run.mjs",
    "test:pact": "npm run test:pact:consumer && npm run test:pact:provider",
    "test:pact:consumer": "node --test test/pact/order-consumer.pact.test.js",
    "test:pact:provider": "node --test test/pact/order-provider.pact.test.js",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "playwright test",
    "test:e2e:stability": "node scripts/verify-e2e-stability.mjs",
    "storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --quiet --disable-telemetry",
    "verify:browser-lock": "node scripts/verify-browser-lock.js"
  },
  "devDependencies": {
    "@pact-foundation/pact": "17.0.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/web-components-vite": "10.5.2",
    "@vitest/browser-playwright": "4.1.12",
    "fast-check": "4.9.0",
    "lit": "3.3.3",
    "storybook": "10.6.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vitest/mocker@>=4.0.0 <4.1.12": "4.1.12",
    "axios@>=1.0.0 <1.20.0": "1.20.0",
    "body-parser@>=2.0.0 <2.4.0": "2.4.0",
    "fast-copy@>=4.0.0 <4.1.0": "4.2.0",
    "follow-redirects@>=1.0.0 <1.16.1": "1.16.1",
    "nanoid@>=3.0.0 <3.3.18": "3.3.20",
    "postcss@>=8.0.0 <8.5.23": "8.5.31",
    "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
    "qs@>=6.0.0 <6.16.0": "6.16.1",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
  }
}
