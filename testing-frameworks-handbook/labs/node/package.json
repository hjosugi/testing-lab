{
  "name": "testing-handbook-node-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:node:module-mock && npm run test:mocha && npm run test:ava && npm run test:semantics && npm run test:unawaited && npm run test:spike",
    "test:node": "node --test test/node/*.test.js",
    "test:node:module-mock": "node --experimental-test-module-mocks --test test/module-mock/*.test.js",
    "test:mocha": "mocha 'test/mocha/**/*.test.js'",
    "test:mocha:parallel": "mocha --parallel --jobs=2 'test/mocha/**/*.test.js'",
    "test:ava": "ava 'test/ava/**/*.test.js'",
    "test:semantics": "node scripts/execution-semantics.mjs --check",
    "record:semantics": "node scripts/execution-semantics.mjs --record",
    "test:unawaited": "node scripts/intentional-failures.mjs --check",
    "record:unawaited": "node scripts/intentional-failures.mjs --record",
    "coverage": "node --test --experimental-test-coverage test/node/*.test.js",
    "test:spike": "node scripts/runner-spike.mjs --check",
    "record:spike": "node scripts/runner-spike.mjs --record"
  },
  "devDependencies": {
    "ava": "8.0.1",
    "mocha": "11.7.6",
    "sinon": "22.0.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.1.4",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
    "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "tar@>=7.0.0 <7.5.21": "7.5.22"
  }
}
