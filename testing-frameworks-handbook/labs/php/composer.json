{
  "name": "handbook/checkout-lab",
  "type": "project",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "infection/infection": "^0.33.3",
    "phpunit/phpunit": "^13.2"
  },
  "autoload": {
    "classmap": ["src/"]
  },
  "autoload-dev": {
    "psr-4": { "Handbook\\Checkout\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "mutation": "infection --threads=max --min-msi=80 --min-covered-msi=90"
  },
  "config": {
    "allow-plugins": { "infection/extension-installer": true },
    "sort-packages": true
  }
}
