  "lanes": {
    "pr": {
      "trigger": "pull_request",
      "budgetMinutes": 15
    },
    "nightly": {
      "trigger": "schedule",
      "budgetMinutes": 90
    },
    "release": {
      "trigger": "release_candidate",
      "budgetMinutes": 180
    },
    "hardware": {
      "trigger": "approved_reservation",
      "budgetMinutes": 240
    }
  },
  "toolEvaluations": [
    {
      "name": "Appium 3",
      "surfaces": [
        "native-ios",
        "native-android",
        "desktop"
      ],
      "mechanisms": [
        "webdriver"
      ],
      "decision": "adopt-cross-platform-black-box-smoke",
      "limitations": [
        "Drivers and plugins are installed and versioned separately from the server.",
        "Appium provides automation, so a runner and test oracle remain separate choices."
      ]
    },
    {
      "name": "Detox",
      "surfaces": [
        "react-native-ios",
        "react-native-android"
      ],
      "mechanisms": [
        "gray-box"
      ],
      "decision": "adopt-react-native-critical-journeys",
      "limitations": [
        "The native client is linked into the test build.",
        "Supported React Native and device configurations must be checked on every upgrade."
      ]
    },
    {
      "name": "XCUITest",
      "surfaces": [
        "native-ios"
      ],
      "mechanisms": [
        "native-ui"
      ],
      "decision": "adopt-ios-platform-default",
      "limitations": [
        "Execution requires Xcode on macOS and Apple signing for physical devices.",
        "System UI coverage is high fidelity, but application internals are not directly observable."
      ]
    },
    {
      "name": "EarlGrey 2",
      "surfaces": [
        "native-ios"
      ],
      "mechanisms": [
        "gray-box",
        "native-ui"
      ],
      "decision": "pilot-when-xcuitest-synchronization-is-insufficient",
      "limitations": [
        "Integration is more invasive than plain XCUITest.",
        "The project branch, Xcode compatibility, and build integration require an explicit pilot."
      ]
    },
    {
      "name": "Espresso",
      "surfaces": [
        "native-android"
      ],
      "mechanisms": [
        "gray-box"
      ],
      "decision": "adopt-android-platform-default",
      "limitations": [
        "Tests run through Android instrumentation and are coupled to Android application builds.",
        "External applications and some system surfaces need UiAutomator or Appium."
      ]
    },
    {
      "name": "Airtest",
      "surfaces": [
        "game",
        "native-mobile",
        "windows"
      ],
      "mechanisms": [
        "image-recognition"
      ],
      "decision": "adopt-only-when-no-stable-semantic-hierarchy-exists",
      "limitations": [
        "Templates drift with resolution, animation, localization, color, and rendering changes.",
        "Image matches do not expose semantic control state."
      ]
    },
    {
      "name": "Poco",
      "surfaces": [
        "game",
        "native-mobile"
      ],
      "mechanisms": [
        "hierarchy-inspection"
      ],
      "decision": "adopt-game-hierarchy-before-image-fallback",
      "limitations": [
        "Game engines normally require the Poco SDK in the application build.",
        "Hierarchy availability and stable identifiers are engine-specific contracts."
      ]
    },
    {
      "name": "Cavy",
      "surfaces": [
        "react-native-ios",
        "react-native-android"
      ],
      "mechanisms": [
        "in-app-hooks"
      ],
      "decision": "pilot-targeted-in-app-integration-only",
      "limitations": [
        "Components need refs or Cavy test hooks.",
        "It does not replace native system UI or black-box device coverage."
      ]
    },
    {
      "name": "Flutter integration_test",
      "surfaces": [
        "flutter-ios",
        "flutter-android",
        "flutter-desktop"
      ],
      "mechanisms": [
        "in-app-hooks"
      ],
      "decision": "adopt-flutter-application-journeys",
      "limitations": [
        "The official package runs on target devices but cannot interact with native platform UI.",
        "Permissions, share sheets, and cross-application flows need a platform UI tool."
      ]
    }
  ],
  "artifactPolicy": {
    "profiles": {
      "local-virtual": {
        "always": [
          "result",
          "runner-log",
          "device-metadata"
        ],
        "onFailure": [
          "device-log",
          "screenshot",
          "video"
        ]
      },
      "device-farm": {
        "always": [
          "result",
          "runner-log",
          "device-log",
          "device-metadata"
        ],
        "onFailure": [
          "screenshot",
          "video"
        ]
      },
      "manual-real-device": {
        "always": [
          "result",
          "runner-log",
          "device-log",
          "device-metadata"
        ],
        "onFailure": [
          "screenshot",
          "video"
        ]
      },
      "hil": {
        "always": [
          "result",
          "runner-log",
          "device-log",
          "device-metadata",
          "rig-telemetry"
        ],
        "onFailure": [
          "screenshot",
          "video",
          "bus-trace"
        ]
      }
    },
    "pathTemplate": "artifacts/{runId}/{scenarioId}/{attempt}/",
    "retentionDays": {
      "passed": 7,
      "failed": 30,
      "release": 90
    },
    "redaction": [
      "Remove credentials, tokens, personal data, and unrelated notifications before upload.",
      "Use synthetic accounts and reset application data after every run."
    ],
    "unsupportedVideoFallback": "Record provider capability metadata and retain timed screenshots plus the platform result bundle and device log."
  },
  "reservationProcedures": {
    "device-farm-queue": {
      "owner": "quality-infrastructure",
      "leadTimeHours": 1,
      "steps": [
        "Check provider capacity and reduced-stability or deprecated-device flags.",
        "Submit scenario, device model, OS, build SHA, data classification, and time budget.",
        "Record the provider matrix ID and result bucket before execution.",
        "Cancel queued work when the release gate is abandoned and link the reason.",
        "Attach the result URL and artifact manifest to the release record."
      ]
    },
    "manual-device-lab": {
      "owner": "quality-infrastructure",
      "leadTimeHours": 24,
      "steps": [
        "Open a reservation ticket with scenario, device or rig ID, build SHA, operator, and time window.",
        "Wait for the lab owner to assign an exclusive lease and confirm preflight state.",
        "Record lease ID, firmware, OS, peripherals, network profile, and calibration before execution.",
        "Stop on safety, thermal, battery, privacy, or fixture-integrity alarms and notify the escalation owner.",
        "Reset application data, remove credentials, restore cables and network, upload artifacts, and release the lease."
      ]
    }
  },
