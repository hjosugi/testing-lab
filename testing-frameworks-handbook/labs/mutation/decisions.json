    {
      "id": "D-PHP-E001",
      "lane": "php-infection",
      "file": "labs/php/mutation-fixtures/BooleanIdentity.php",
      "classification": "equivalent",
      "match": {
        "mutator": "CastBool",
        "original": "return (bool) $value;",
        "replacement": "return $value;"
      },
      "rationale": "The parameter is declared bool, so removing the cast cannot change value or type for either input; both inputs are exhausted by the data provider.",
      "owner": "testing-lab maintainers",
      "reviewBy": "2027-03-31",
      "evidence": "labs/php/MUTATION_CLASSIFICATION.md#e-001-equivalent-castbool, labs/php/scripts/verify-equivalent-mutant.sh"
    },
    {
      "id": "D-PY-MSG",
      "lane": "python-curated",
      "file": "labs/python/src/checkout/domain.py",
      "classification": "low-value",
      "match": {
        "mutator": "string literal",
        "original": "ValueError(\"<message>\")",
        "replacement": "ValueError(None | \"XX<message>XX\" | \"<MESSAGE>\")"
      },
      "rationale": "14 of 15 mutmut survivors only rewrite exception message text. The public contract is the exception type plus the guarded state (no capture, no save); messages are for humans and asserting every one would couple tests to wording. The curated lane therefore does not include message mutants.",
      "owner": "testing-lab maintainers",
      "reviewBy": "2027-03-31",
      "evidence": "labs/mutation/SPIKE.md#python"
    }
  ],
